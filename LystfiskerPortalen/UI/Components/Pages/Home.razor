@page "/"
@using Microsoft.AspNetCore.Components

<h1 class="mb-4 text-center">Fællesskaber</h1>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var channel in channels)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@channel.Name</h5>
                    <p class="card-text">@channel.Description</p>
                    <a class="btn btn-primary" href="@channel.Url">Gå til kanal</a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ChannelLink> channels = new()
    {
        new ChannelLink(1, "Nordjylland", ""),
        new ChannelLink(2, "Midtjylland", ""),
        new ChannelLink(3, "Syddanmark", ""),
        new ChannelLink(4, "Sjælland", ""),
        new ChannelLink(5, "Hovedstaden", ""),
        new ChannelLink(6, "Bornholm", "")
    };

    private class ChannelLink
    {
        public int Id { get; }
        public string Name { get; }
        public string Description { get; }
        public string Url => $"/kanal/{Id}";

        public ChannelLink(int id, string name, string description)
        {
            Id = id;
            Name = name;
            Description = description;
        }
    }
}