@* @page "/profile/{ChannelId:int}"

@using LystfiskerPortalen.Application.Models


<div>
    <h3>Profile: @profile.</h3>

    @if (profile?. == null)
    {
        <p>Der er ikke nogen opslag på denne kanal endnu</p>
    }
    else
    {
        <ul>
            @foreach (var post in profile.)
            {
                <li>@post.Date.ToShortDateString() - @post.Description</li>
            }
        </ul>
    }
</div>
@code {
    [Parameter] public int ChannelId { get; set; }
    private Profile? profile;

    protected override async Task OnParametersSetAsync()
    {
        channel = await ChannelRepo.GetChannelByIdAsync(ChannelId);
    }
}
 *@