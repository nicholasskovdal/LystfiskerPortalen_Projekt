@page "/kanal/{ChannelId:int}"
@using LystfiskerPortalen.Application.Interfaces
@using LystfiskerPortalen.UI.Components.Controls
@using LystfiskerPortalen.UI.ViewModels
@using Microsoft.AspNetCore.Components.Authorization
@inject IChannelRepository ChannelRepo
@inject AuthenticationStateProvider AuthProvider /*replaces UserManager in .razor files*/

<div class="">
    @if (!isAuthenticated) //Only logged in users must be able to view posts
    {
        <p>Du skal logge ind for at se opslag</p>
    }
    else
    {
        <h3>Channel: @channelViewModel?.Name</h3>
        <PostFormControl ChannelId="@ChannelId.ToString()"></PostFormControl> //Skriv en post UI

        @if (channelViewModel?.Posts == null || !channelViewModel.Posts.Any())
        {
            <p>Der er ikke nogen opslag på denne kanal endnu</p>
        }
        else
        {
            <div class="">
                @foreach (var post in channelViewModel.Posts)
                {
                    <PostControl postViewModel="@post"/>
                }
            </div>
        }
    }
</div>
@code {
    [Parameter] public int ChannelId { get; set; }

    private ChannelViewModel? channelViewModel;
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;
    }

    protected override async Task OnParametersSetAsync()
    {
        var channel = await ChannelRepo.GetChannelByIdAsync(ChannelId);
        if (channel != null)
        {
            channelViewModel = new ChannelViewModel
            {
                ChannelId = channel.ChannelId,
                Name = channel.Name,
                Posts = channel.Posts.Select(p => new PostViewModel
                {
                    PostId = p.PostId,
                    Description = p.Description,
                    Date = p.Date,
                    Bait = p.Bait,
                    Location = p.Location,
                    Technique = p.Technique,
                    ImageUrl = p.ImageUrl,
                    Inspiration = p.Inspiration,
                    CreatedAt = p.CreatedAt,
                    AuthorName = p.AppUser?.Profile.ProfileName ?? "Ukendt",
                    Interactions = p.Interactions.Select(i => new InteractionViewModel
                    {
                        InteractionId = i.InteractionId,
                        Type = i.Type,
                        Content = i.Content,
                        CreatedAt = i.CreatedAt,
                        AuthorName = i.AppUser?.Profile.ProfileName ?? "Ukendt"
                    }).ToList()
                }).ToList()
            };
        }
    }

}
