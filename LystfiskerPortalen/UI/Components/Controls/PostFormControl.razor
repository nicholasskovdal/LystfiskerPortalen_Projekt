@using LystfiskerPortalen.Application.Interfaces
@using LystfiskerPortalen.UI.ViewModels
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthProvider
@inject IPostService PostService
@rendermode InteractiveServer

<div class="d-flex justify-content-center">
    <div class="card mb-4 shadow-sm" style="width: 100%; max-width: 700px;">
        <div class="card-header">
            <strong>Opret nyt opslag</strong>
        </div>

        <div class="card-body">
            <EditForm Model="@formModel" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <InputTextArea class="form-control" @bind-Value="formModel.Description" placeholder="Beskriv din fangst..." />
                </div>

                @if (!string.IsNullOrEmpty(formModel.ImageUrl))
                {
                    <img src="@formModel.ImageUrl" class="img-fluid rounded mb-3" alt="Preview image" />
                }

                <div class="mb-3">
                    <InputText class="form-control" @bind-Value="formModel.ImageUrl" placeholder="Billede URL (valgfrit)" />
                </div>

                <div class="mb-3">
                    <InputText class="form-control" @bind-Value="formModel.Location" placeholder="Sted (valgfrit)" />
                </div>

                <div class="mb-3">
                    <InputText class="form-control" @bind-Value="formModel.Bait" placeholder="Blink el. madding (valgfrit)" />
                </div>

                <div class="mb-3">
                    <InputText class="form-control" @bind-Value="formModel.Technique" placeholder="Teknik (valgfrit)" />
                </div>

                <div class="mb-3">
                    <InputText class="form-control" @bind-Value="formModel.Inspiration" placeholder="Inspiration (valgfrit)" />
                </div>

                <div class="mb-3">
                    <InputDate class="form-control" @bind-Value="formModel.Date" />
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">Opret opslag</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter] public string ChannelId { get; set; }
    [Parameter] public EventCallback OnPostCreated { get; set; }

    private PostFormViewModel formModel = new();
    private string? userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        formModel.ChannelId = ChannelId;
    }

    private async Task HandleSubmit()
    {
        Console.WriteLine($"Submitting post for channel {formModel.ChannelId}, user {userId}");

        if (userId != null)
        {
            await PostService.CreatePostAsync(formModel, userId);
            formModel = new(); // reset form

            await OnPostCreated.InvokeAsync();
        }
        else
        {
            Console.WriteLine("No userId found");
        }
    }
}
