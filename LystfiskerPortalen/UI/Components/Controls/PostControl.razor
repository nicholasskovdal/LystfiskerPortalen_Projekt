@using LystfiskerPortalen.Application.Enums
@using LystfiskerPortalen.Application.Interfaces
@using LystfiskerPortalen.UI.ViewModels
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthProvider
@inject IInteractionService InteractionService
@rendermode InteractiveServer


<div class="d-flex justify-content-center">
    <div class="card mb-4 shadow-sm" style="width: 100%; max-width: 700px;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="text-muted">@postViewModel.CreatedAt.ToShortDateString()</span>
            <strong>@postViewModel.AuthorName</strong>
        </div>

        <div class="card-body">
            <p class="card-text">@postViewModel.Description</p>

            @if (!string.IsNullOrEmpty(postViewModel.ImageUrl))
            {
                <img src="@postViewModel.ImageUrl" class="img-fluid rounded mb-3" alt="Post image" />
            }

            <ul class="list-unstyled">
                @if (!string.IsNullOrEmpty(postViewModel.Location))
                {
                    <li><strong>Sted:</strong> @postViewModel.Location</li>
                }
                @if (!string.IsNullOrEmpty(postViewModel.Bait))
                {
                    <li><strong>Blink/madding:</strong> @postViewModel.Bait</li>
                }
                @if (!string.IsNullOrEmpty(postViewModel.Technique))
                {
                    <li><strong>Teknik:</strong> @postViewModel.Technique</li>
                }
                @if (!string.IsNullOrEmpty(postViewModel.Inspiration))
                {
                    <li><strong>Inspiration:</strong> @postViewModel.Inspiration</li>
                }
                @if (postViewModel.Date != default)
                {
                    <li><strong>Fangstdato:</strong> @postViewModel.Date.ToShortDateString()</li>
                }
            </ul>

            <div class="d-flex gap-3 mt-3">
                <button class="btn btn-outline-primary" @onclick="ToggleLike">
                    @(userHasLiked ? "Fjern Like" : "Like")
                    (@postViewModel.Interactions.Count(i => i.Type == InteractionType.Like))
                </button>

                <button class="btn btn-outline-secondary" @onclick="SharePost">
                    Del (@postViewModel.Interactions.Count(i => i.Type == InteractionType.Share))
                </button>
            </div>
        </div>

        <div class="card-footer">
            @if (postViewModel.Interactions.Any(i => i.Type == InteractionType.Comment))
            {
                <div class="mb-3">
                    @foreach (var comment in postViewModel.Interactions.Where(i => i.Type == InteractionType.Comment))
                    {
                        <CommentControl />
                    }
                </div>
            }

            <div class="d-flex justify-content-end">
                <button class="btn btn-sm btn-outline-dark" @onclick="ShowCommentForm">Skriv Kommentar</button>
            </div>

            @if (showCommentForm)
            {
                <div class="mt-3">
                    <CommentFormControl PostId="@postViewModel.PostId" />
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public PostViewModel postViewModel { get; set; }
    [Parameter] public EventCallback OnInteractionChanged { get; set; } //event part 1

    private bool showCommentForm = false;
    private string? userId;
    private bool userHasLiked => postViewModel.Interactions.Any(i => i.Type == InteractionType.Like && i.AuthorName == postViewModel.AuthorName);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value; //åbenbart sådan man skal få fat i userId - value of ClaimTypes URI specifikation
    }


    //Lokale metoder
    private void ShowCommentForm() => showCommentForm = true;

    private async Task ToggleLike()
    {
        if (userId != null)
        {
            await InteractionService.ToggleLikeAsync(postViewModel.PostId, userId);
            await OnInteractionChanged.InvokeAsync(); //event part 2
        }
    }

    private async Task SharePost()
    {
        if (userId != null)
        {
            await InteractionService.AddShareAsync(postViewModel.PostId, userId);
        }
    }

    private Task ReloadPost()
    {
        return Task.CompletedTask;
    }
}
